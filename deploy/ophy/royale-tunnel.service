[Unit]
Description=Launchpad Royale Cloudflare tunnel (royale.botcade.xyz)
After=royale.service network-online.target
Wants=royale.service network-online.target

[Service]
User=z80
ExecStart=/usr/local/bin/cloudflared tunnel --config /home/z80/services/royale/deploy/ophy/tunnel.yml run
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
